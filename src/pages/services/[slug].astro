---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import { servicePages } from '../../data/servicePages.js';
import { services } from '../../data/site.js';
import { images, img } from '../../data/images.js';

export function getStaticPaths() {
  return Object.keys(servicePages).map((slug) => ({
    params: { slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const page = servicePages[slug];
const heroImage = images.services[slug];
const related = services.filter((s) => s.id !== slug);
const quoteHref = '/#contact';
---

<Layout title={page.metaTitle} description={page.metaDescription}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-hero-grad pt-28 md:pt-36 pb-16 md:pb-20">
    <div class="pointer-events-none absolute -top-24 -right-24 w-[30rem] h-[30rem] rounded-full bg-lime-accent-400/15 blur-3xl"></div>
    <div class="container-x relative">
      <nav class="mb-6 text-sm text-forest-700/60" aria-label="Breadcrumb">
        <a href="/" class="hover:text-forest-700">Home</a>
        <span class="mx-2">/</span>
        <a href="/#services" class="hover:text-forest-700">Services</a>
        <span class="mx-2">/</span>
        <span class="text-forest-800 font-500">{page.navLabel}</span>
      </nav>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="reveal">
          <span class="eyebrow">{page.hero.eyebrow}</span>
          <h1 class="mt-4 text-3xl sm:text-4xl lg:text-5xl leading-[1.08] font-800 text-forest-900">
            {page.hero.title}
          </h1>
          {page.hero.paras.map((p) => <p class="mt-5 text-lg text-forest-800/70 leading-relaxed">{p}</p>)}
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href={quoteHref} variant="primary" size="lg" icon="arrow">Request a Free Quote</Button>
            <Button href={quoteHref} variant="ghost" size="lg">Book a Site Inspection</Button>
          </div>
        </div>
        <div class="reveal" data-delay="120ms">
          <div class="rounded-[1.75rem] overflow-hidden shadow-2xl shadow-forest-900/20 ring-1 ring-forest-900/5 aspect-[4/3] lg:aspect-[5/4]">
            <img
              src={img(heroImage, { w: 1000, h: 800, q: 74 })}
              alt={page.hero.title}
              width="1000"
              height="800"
              loading="eager"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-16 md:py-24">
    <div class="container-x max-w-3xl reveal">
      <h2 class="text-3xl sm:text-4xl font-800 text-forest-900 leading-tight">{page.intro.heading}</h2>
      {page.intro.paras.map((p) => <p class="mt-5 text-forest-800/75 leading-relaxed text-lg">{p}</p>)}
    </div>
  </section>

  <!-- Service Standard -->
  {
    page.standard && (
      <section class="py-16 md:py-24 bg-white">
        <div class="container-x">
          <div class="max-w-2xl reveal">
            <span class="eyebrow">Our approach</span>
            <h2 class="mt-4 text-3xl sm:text-4xl font-800 text-forest-900">{page.standard.heading}</h2>
            <p class="mt-4 text-forest-800/70 leading-relaxed">{page.standard.intro}</p>
          </div>
          <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
            {page.standard.items.map((it, i) => (
              <div class="reveal card-lift bg-sand-50 rounded-2xl p-6 ring-1 ring-forest-900/5" data-delay={`${(i % 3) * 70}ms`}>
                <span class="grid place-items-center w-11 h-11 rounded-xl bg-forest-600 text-lime-accent-400 font-display font-700">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-4 font-display font-700 text-lg text-forest-900">{it.title}</h3>
                <p class="mt-2 text-sm text-forest-700/75 leading-relaxed">{it.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- What's included -->
  <section class="py-16 md:py-24">
    <div class="container-x">
      <div class="max-w-2xl reveal">
        <span class="eyebrow">What we clean</span>
        <h2 class="mt-4 text-3xl sm:text-4xl font-800 text-forest-900">{page.included.heading}</h2>
        {page.included.intro && <p class="mt-4 text-forest-800/70 leading-relaxed">{page.included.intro}</p>}
      </div>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          page.included.groups.map((g, i) => (
            <div class="reveal card-lift bg-white rounded-2xl p-6 ring-1 ring-forest-900/5 shadow-sm" data-delay={`${(i % 3) * 60}ms`}>
              <h3 class="font-display font-700 text-forest-900 flex items-center gap-2">
                <Icon name="check" class="w-5 h-5 text-lime-accent-600 shrink-0" />
                {g.title}
              </h3>
              {g.text && <p class="mt-2 text-sm text-forest-700/75 leading-relaxed">{g.text}</p>}
              {g.items && (
                <ul class="mt-3 space-y-1.5">
                  {g.items.map((it) => (
                    <li class="flex items-center gap-2 text-sm text-forest-800/80">
                      <span class="w-1.5 h-1.5 rounded-full bg-lime-accent-500 shrink-0" />
                      {it}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why + Industries -->
  <section class="py-16 md:py-24 bg-forest-950 text-sand-100">
    <div class="container-x grid lg:grid-cols-2 gap-12 lg:gap-16">
      <div class="reveal">
        <span class="eyebrow" style="color:#d8bd63">Why Atlas</span>
        <h2 class="mt-4 text-3xl sm:text-4xl font-800 text-white">{page.why.heading}</h2>
        {page.why.paras.map((p) => <p class="mt-4 text-sand-100/75 leading-relaxed">{p}</p>)}
        {
          page.why.checks && (
            <ul class="mt-6 grid sm:grid-cols-2 gap-x-6 gap-y-3">
              {page.why.checks.map((c) => (
                <li class="flex items-center gap-3 text-sand-100/90">
                  <span class="grid place-items-center w-6 h-6 rounded-full bg-lime-accent-400 text-forest-900 shrink-0">
                    <Icon name="check" class="w-4 h-4" />
                  </span>
                  {c}
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <div class="reveal" data-delay="100ms">
        <span class="eyebrow" style="color:#d8bd63">{page.industries.heading}</span>
        {page.industries.intro && <p class="mt-4 text-sand-100/70">{page.industries.intro}</p>}
        <div class="mt-6 flex flex-wrap gap-2.5">
          {page.industries.items.map((it) => (
            <span class="inline-flex items-center rounded-full bg-white/5 ring-1 ring-white/10 px-4 py-2 text-sm text-sand-100/85">
              {it}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-x">
      <div class="max-w-2xl reveal">
        <span class="eyebrow">How it works</span>
        <h2 class="mt-4 text-3xl sm:text-4xl font-800 text-forest-900">{page.process.heading}</h2>
      </div>
      <ol class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          page.process.steps.map((s, i) => (
            <li class="reveal relative bg-sand-50 rounded-2xl p-6 ring-1 ring-forest-900/5" data-delay={`${(i % 4) * 60}ms`}>
              <span class="font-display font-800 text-forest-200 text-4xl leading-none">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 font-display font-700 text-forest-900">{s.title}</h3>
              <p class="mt-2 text-sm text-forest-700/75 leading-relaxed">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-16 md:py-24">
    <div class="container-x max-w-3xl">
      <div class="reveal">
        <span class="eyebrow">Good to know</span>
        <h2 class="mt-4 text-3xl sm:text-4xl font-800 text-forest-900">Frequently Asked Questions</h2>
      </div>
      <div class="mt-8 divide-y divide-sand-200 border-y border-sand-200">
        {
          page.faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-600 text-forest-900">
                {f.q}
                <span class="grid place-items-center w-7 h-7 rounded-full bg-forest-50 text-forest-600 shrink-0 transition-transform group-open:rotate-45">
                  <Icon name="close" class="w-4 h-4 rotate-45" />
                </span>
              </summary>
              <p class="mt-3 text-forest-800/75 leading-relaxed">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-8">
    <div class="container-x">
      <div class="reveal relative overflow-hidden rounded-[2rem] bg-forest-800 px-8 py-14 md:px-16 md:py-16 shadow-2xl shadow-forest-900/25">
        <div class="pointer-events-none absolute -top-16 -right-10 w-72 h-72 rounded-full bg-lime-accent-400/15 blur-3xl"></div>
        <div class="relative max-w-3xl">
          <h2 class="text-3xl sm:text-4xl font-800 text-white leading-tight">{page.cta.heading}</h2>
          {page.cta.paras.map((p) => <p class="mt-4 text-lg text-sand-100/85 leading-relaxed">{p}</p>)}
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href={quoteHref} variant="secondary" size="lg" icon="arrow">Request a Free Quote</Button>
            <Button href={quoteHref} variant="white" size="lg">Book a Site Inspection</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related services -->
  <section class="py-16 md:py-24">
    <div class="container-x">
      <h2 class="text-2xl sm:text-3xl font-800 text-forest-900 reveal">Other cleaning services</h2>
      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          related.map((s) => (
            <a href={s.href} class="reveal card-lift group flex items-center gap-4 bg-white rounded-2xl p-5 ring-1 ring-forest-900/5 shadow-sm hover:shadow-lg hover:ring-forest-200">
              <span class="grid place-items-center w-12 h-12 rounded-xl bg-forest-50 text-forest-600 group-hover:bg-forest-600 group-hover:text-lime-accent-400 transition-colors shrink-0">
                <Icon name={s.icon} class="w-6 h-6" />
              </span>
              <span class="font-display font-600 text-forest-900 leading-tight">{s.title}</span>
              <Icon name="arrow" class="w-4 h-4 text-forest-400 ml-auto transition-transform group-hover:translate-x-1" />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
