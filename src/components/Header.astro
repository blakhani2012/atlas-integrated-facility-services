---
import { company, nav } from '../data/site.js';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { link } from '../lib/link.js';
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300"
  data-scrolled="false"
>
  <div class="container-x">
    <nav
      class="mt-3 md:mt-4 flex items-center justify-between rounded-full px-4 md:px-5 py-2.5 transition-all duration-300
             bg-white/80 backdrop-blur-md ring-1 ring-forest-900/5 shadow-lg shadow-forest-900/5"
      aria-label="Primary"
    >
      <a href={link('/')} class="flex items-center gap-2.5 shrink-0" aria-label={`${company.name} home`}>
        <Logo class="h-9 w-9" />
        <span class="font-display font-700 text-forest-800 leading-tight text-[15px] md:text-base">
          Atlas<span class="hidden sm:inline text-forest-500 font-500"> Facility Services</span>
        </span>
      </a>

      <ul class="hidden lg:flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={link(item.href)}
                class="px-3.5 py-2 text-sm font-500 text-forest-700 rounded-full hover:bg-forest-50 hover:text-forest-900 transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <a
          href={company.phoneHref}
          class="hidden md:inline-flex items-center gap-2 text-sm font-600 text-forest-700 hover:text-forest-900 px-3 py-2"
        >
          <Icon name="phone" class="w-4 h-4" />
          {company.phone}
        </a>
        <a
          href={link('/#contact')}
          class="hidden sm:inline-flex items-center gap-2 bg-forest-600 text-white text-sm font-600 px-5 py-2.5 rounded-full hover:bg-forest-700 transition-colors shadow-md shadow-forest-900/10"
        >
          Get a Free Quote
        </a>
        <button
          id="menu-toggle"
          class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-full text-forest-800 hover:bg-forest-50"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="menu" class="w-6 h-6" />
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-0 z-40 hidden"
    role="dialog"
    aria-modal="true"
  >
    <div id="menu-backdrop" class="absolute inset-0 bg-forest-950/40 backdrop-blur-sm"></div>
    <div
      class="absolute top-0 right-0 h-full w-[82%] max-w-sm bg-white shadow-2xl p-6 flex flex-col
             translate-x-full transition-transform duration-300 ease-out"
      id="menu-panel"
    >
      <div class="flex items-center justify-between mb-8">
        <span class="font-display font-700 text-forest-800">Menu</span>
        <button
          id="menu-close"
          class="w-10 h-10 inline-flex items-center justify-center rounded-full hover:bg-forest-50 text-forest-800"
          aria-label="Close menu"
        >
          <Icon name="close" class="w-6 h-6" />
        </button>
      </div>
      <ul class="flex flex-col gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={link(item.href)}
                class="menu-link block px-4 py-3 rounded-xl text-lg font-600 text-forest-800 hover:bg-forest-50"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-auto pt-6 border-t border-sand-200 space-y-3">
        <a
          href={company.phoneHref}
          class="flex items-center gap-3 text-forest-700 font-600"
        >
          <Icon name="phone" class="w-5 h-5" />
          {company.phone}
        </a>
        <a
          href={link('/#contact')}
          class="menu-link block text-center bg-forest-600 text-white font-600 px-5 py-3.5 rounded-full hover:bg-forest-700"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Header shadow / shrink on scroll
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (!header) return;
    header.dataset.scrolled = window.scrollY > 12 ? 'true' : 'false';
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu open/close
  const menu = document.getElementById('mobile-menu');
  const panel = document.getElementById('menu-panel');
  const toggle = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('menu-close');
  const backdrop = document.getElementById('menu-backdrop');

  const open = () => {
    if (!menu || !panel) return;
    menu.classList.remove('hidden');
    requestAnimationFrame(() => panel.classList.remove('translate-x-full'));
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const close = () => {
    if (!menu || !panel) return;
    panel.classList.add('translate-x-full');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => menu.classList.add('hidden'), 300);
  };

  toggle?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);
  backdrop?.addEventListener('click', close);
  document.querySelectorAll('.menu-link').forEach((l) => l.addEventListener('click', close));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && close());
</script>

<style>
  #site-header[data-scrolled='true'] nav {
    box-shadow: 0 8px 30px -10px rgba(13, 46, 29, 0.25);
  }
</style>
