---
/**
 * Lightweight inline icon set (stroke-based, 24x24).
 * Usage: <Icon name="leaf" class="w-6 h-6" />
 */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'w-6 h-6' } = Astro.props;

const paths: Record<string, string> = {
  shield: '<path d="M12 3l7 3v5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6l7-3z"/><path d="M9.5 12l1.8 1.8L15 10"/>',
  users:
