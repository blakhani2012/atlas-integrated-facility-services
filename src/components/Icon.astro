  quote: '<path d="M9 7H5v6h4v-2a4 4 0 0 1-4-4zM19 7h-4v6h4v-2a4 4 0 0 1-4-4z" transform="translate(0,1)"/>',
};

const inner = paths[name] ?? '';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
