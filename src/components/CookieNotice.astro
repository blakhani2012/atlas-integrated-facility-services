---
import { link } from '../lib/link.js';
---

<div id="cookie-notice" class="hidden fixed inset-x-4 bottom-4 sm:inset-x-0 z-50">
  <div class="mx-auto max-w-2xl bg-white rounded-2xl shadow-2xl shadow-forest-900/20 ring-1 ring-forest-900/10 p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
    <p class="text-sm text-forest-800/80 leading-relaxed flex-1">
      We use cookies to run our live chat and improve your experience. See our
      <a href={link('/privacy-policy')} class="text-forest-600 font-600 underline underline-offset-2 hover:text-forest-800">Privacy Policy</a>.
    </p>
    <button
      id="cookie-ok"
      class="shrink-0 bg-forest-600 hover:bg-forest-700 text-white text-sm font-600 px-6 py-2.5 rounded-full transition-colors"
    >
      Got it
    </button>
  </div>
</div>

<script>
  const KEY = 'atlas-cookie-ok';
  const el = document.getElementById('cookie-notice');
  if (el && !localStorage.getItem(KEY)) {
    el.classList.remove('hidden');
    document.body.classList.add('cookie-open');
  }
  document.getElementById('cookie-ok')?.addEventListener('click', () => {
    try {
      localStorage.setItem(KEY, '1');
    } catch (e) {}
    el?.classList.add('hidden');
    document.body.classList.remove('cookie-open');
  });
</script>
