---
import { sectors } from '../data/site.js';
import Icon from './Icon.astro';
---

<section id="sectors" class="py-20 md:py-28 bg-sand-100/60">
  <div class="container-x">
    <div class="max-w-2xl reveal">
      <span class="eyebrow">Industries we serve</span>
      <h2 class="mt-4 text-3xl sm:text-4xl font-800 text-forest-900 leading-tight">
        Trusted across every kind of site
      </h2>
      <p class="mt-4 text-forest-800/70 leading-relaxed">
        From single tenancies to national portfolios, our teams understand the compliance,
        presentation and safety demands of your industry.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-5">
      {
        sectors.map((s, i) => (
          <div
            class="reveal card-lift group flex items-center gap-4 bg-white rounded-2xl p-5 ring-1 ring-forest-900/5 shadow-sm hover:shadow-lg hover:ring-forest-200"
            data-delay={`${(i % 3) * 70}ms`}
          >
            <span class="grid place-items-center w-12 h-12 rounded-xl bg-forest-50 text-forest-600 group-hover:bg-forest-600 group-hover:text-lime-accent-400 transition-colors shrink-0">
              <Icon name={s.icon} class="w-6 h-6" />
            </span>
            <span class="font-display font-600 text-forest-900 leading-tight">{s.name}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
