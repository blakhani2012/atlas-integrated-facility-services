---
import { testimonials } from '../data/site.js';
import Icon from './Icon.astro';
---

<section id="testimonials" class="py-20 md:py-28 bg-white">
  <div class="container-x">
    <div class="max-w-2xl reveal">
      <span class="eyebrow">Client stories</span>
      <h2 class="mt-4 text-3xl sm:text-4xl font-800 text-forest-900 leading-tight">
        The results speak for themselves
      </h2>
    </div>

    <div class="mt-12 grid md:grid-cols-3 gap-6">
      {
        testimonials.map((t, i) => (
          <figure
            class="reveal card-lift relative flex flex-col rounded-2xl bg-sand-50 p-7 ring-1 ring-forest-900/5 shadow-lg shadow-forest-900/5"
            data-delay={`${i * 90}ms`}
          >
            <Icon name="quote" class="w-9 h-9 text-lime-accent-500" />
            <div class="mt-3 flex gap-0.5 text-lime-accent-500" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }).map(() => (
                <Icon name="star" class="w-4 h-4 fill-current" />
              ))}
            </div>
            <blockquote class="mt-4 text-forest-800/90 leading-relaxed flex-1">"{t.quote}"</blockquote>
            <figcaption class="mt-6 pt-5 border-t border-sand-200">
              <p class="font-display font-700 text-forest-900">{t.name}</p>
              <p class="text-sm text-forest-700/60">{t.role}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
