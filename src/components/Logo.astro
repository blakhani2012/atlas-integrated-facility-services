---
/**
 * Atlas logo mark — a rounded badge holding an abstract "A"
 * formed from two leaves (integrated services + sustainability).
 */
interface Props {
  class?: string;
}
const { class: className = 'h-9 w-9' } = Astro.props;
const gid = 'atlas-logo-grad';
---

<svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Atlas">
  <defs>
    <linearGradient id={gid} x1="6" y1="4" x2="42" y2="44" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#2e7d4f" />
      <stop offset="1" stop-color="#123d26" />
    </linearGradient>
  </defs>
  <rect x="2" y="2" width="44" height="44" rx="13" fill={`url(#${gid})`} />
  <!-- left leaf stroke of the A -->
  <path
    d="M24 11c-5.5 6-9 10.5-9 16.5 0 .9.1 1.7.3 2.5"
    stroke="#a8e063"
    stroke-width="3.2"
    stroke-linecap="round"
    fill="none"
  />
  <!-- right leaf stroke of the A -->
  <path
    d="M24 11c5.5 6 9 10.5 9 16.5 0 4.9-4 8.5-9 8.5s-9-3.6-9-8.5"
    stroke="#ffffff"
    stroke-width="3.2"
    stroke-linecap="round"
    fill="none"
  />
  <!-- crossbar leaf vein -->
  <path d="M18.5 27h11" stroke="#a8e063" stroke-width="3.2" stroke-linecap="round" />
</svg>
