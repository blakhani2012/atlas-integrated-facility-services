---
/**
 * Atlas logo mark — angular "A" with ascending sparkles and motion lines,
 * recreated in SVG from the client artwork. Monochrome gold (brand), no badge,
 * so it sits cleanly on both light and dark backgrounds.
 */
interface Props {
  class?: string;
  color?: string;
}
const { class: className = 'h-10 w-10', color = '#c6a545' } = Astro.props;
---

<svg class={className} viewBox="0 0 56 60" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Atlas">
  <g stroke={color} stroke-linecap="round" stroke-linejoin="round">
    <!-- A -->
    <path d="M28 16 L16 46" stroke-width="5" />
    <path d="M28 16 L40 46" stroke-width="5" />
    <path d="M21.5 34.5 H34.5" stroke-width="5" />
    <!-- left foot -->
    <path d="M12.5 46 H20.5" stroke-width="5" />
    <!-- motion lines -->
    <path d="M32 40.5 H45" stroke-width="3.4" />
    <path d="M34.5 45 H46.5" stroke-width="3.4" />
  </g>
  <!-- sparkles -->
  <polygon fill={color} points="30,5.8 31.02,7.98 33.2,9 31.02,10.02 30,12.2 28.98,10.02 26.8,9 28.98,7.98" />
  <polygon fill={color} points="34,2.5 34.64,3.86 36,4.5 34.64,5.14 34,6.5 33.36,5.14 32,4.5 33.36,3.86" />
  <polygon fill={color} points="26.5,4.1 26.95,5.05 27.9,5.5 26.95,5.95 26.5,6.9 26.05,5.95 25.1,5.5 26.05,5.05" />
</svg>
