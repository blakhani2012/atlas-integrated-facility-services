---
/**
 * Atlas logo mark — the client's actual artwork (gold triangle-A with sparkles
 * and motion lines), exported from the supplied logo. Transparent PNG, so it
 * sits on light and dark backgrounds; height-driven so it scales on all screens.
 */
interface Props {
  class?: string;
}
const { class: className = 'h-10 w-auto' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<img
  src={`${base}/images/atlas-mark.png`}
  alt="Atlas"
  width="1172"
  height="1281"
  loading="eager"
  decoding="async"
  class={className}
/>
