---
/**
 * Atlas logo mark — angular "A" with sparkles (top) and motion lines
 * (lower right), on a rounded forest-green badge so it reads on both light
 * and dark backgrounds. Recreated in SVG from the client artwork; brand
 * colours forest green + gold. (Swap for the exact vector when supplied.)
 */
interface Props {
  class?: string;
}
const { class: className = 'h-9 w-9' } = Astro.props;
const gid = 'atlas-badge-grad';
---

<svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Atlas">
  <defs>
    <linearGradient id={gid} x1="6" y1="4" x2="42" y2="44" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#2e7d4f" />
      <stop offset="1" stop-color="#123d26" />
    </linearGradient>
  </defs>
  <rect x="2" y="2" width="44" height="44" rx="13" fill={`url(#${gid})`} />

  <!-- Angular A -->
  <path d="M23.5 13 L15 34" stroke="#ffffff" stroke-width="3.1" stroke-linecap="round" />
  <path d="M23.5 13 L31.5 32.5" stroke="#ffffff" stroke-width="3.1" stroke-linecap="round" />
  <path d="M18.6 27.5 H28.4" stroke="#d8bd63" stroke-width="3.1" stroke-linecap="round" />
  <!-- left foot -->
  <path d="M12.5 34 H18.5" stroke="#ffffff" stroke-width="3.1" stroke-linecap="round" />

  <!-- motion lines (lower right) -->
  <path d="M27 31.5 H35" stroke="#d8bd63" stroke-width="2.4" stroke-linecap="round" />
  <path d="M29 34.5 H35.5" stroke="#d8bd63" stroke-width="2.4" stroke-linecap="round" />

  <!-- sparkles (top) -->
  <path d="M28 5.2 L28.9 8 L31.7 8.9 L28.9 9.8 L28 12.6 L27.1 9.8 L24.3 8.9 L27.1 8 Z" fill="#d8bd63" />
  <path d="M32.6 10.4 L33.1 11.9 L34.6 12.4 L33.1 12.9 L32.6 14.4 L32.1 12.9 L30.6 12.4 L32.1 11.9 Z" fill="#e7d190" />
</svg>
