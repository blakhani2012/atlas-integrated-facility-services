---
import { whyReasons } from '../data/site.js';
import { images, img } from '../data/images.js';
import Icon from './Icon.astro';
---

<section id="why" class="py-20 md:py-28">
  <div class="container-x">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Copy / reasons -->
      <div class="order-2 lg:order-1">
        <div class="reveal max-w-xl">
          <span class="eyebrow">Why Atlas</span>
          <h2 class="mt-4 text-3xl sm:text-4xl font-800 text-forest-900 leading-tight">
            Why businesses choose Atlas
          </h2>
          <p class="mt-4 text-forest-800/70 leading-relaxed">
            Businesses don't just choose a cleaning company — they choose a partner they can rely on.
            We focus on reliability, communication and accountability as much as the cleaning itself.
          </p>
        </div>

        <div class="mt-8 space-y-4">
          {
            whyReasons.map((r, i) => (
              <div
                class="reveal flex gap-4 rounded-2xl bg-white p-5 ring-1 ring-forest-900/5 shadow-sm hover:shadow-lg transition-shadow"
                data-delay={`${i * 70}ms`}
              >
                <span class="grid place-items-center w-11 h-11 shrink-0 rounded-xl bg-forest-600 text-lime-accent-400 font-display font-700">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-display font-700 text-forest-900">{r.title}</h3>
                  <p class="mt-1 text-sm text-forest-700/70 leading-relaxed">{r.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Image -->
      <div class="order-1 lg:order-2 reveal">
        <div class="relative">
          <div class="rounded-[1.75rem] overflow-hidden shadow-2xl shadow-forest-900/15 ring-1 ring-forest-900/5 aspect-[4/5] lg:aspect-[5/6]">
            <img
              src={img(images.whyChoose, { w: 900, h: 1100 })}
              alt="A clean, well-maintained workspace kept in top condition by Atlas"
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="absolute -bottom-6 right-4 sm:-right-6 bg-white rounded-2xl shadow-xl ring-1 ring-forest-900/5 p-5 flex items-center gap-3 max-w-[15rem]">
            <span class="grid place-items-center w-11 h-11 rounded-xl bg-lime-accent-400 text-forest-900 shrink-0">
              <Icon name="shield" class="w-6 h-6" />
            </span>
            <p class="text-sm font-600 text-forest-900 leading-snug">Fully insured &amp; compliance-ready on every site</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
