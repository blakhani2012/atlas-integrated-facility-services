---
import { images, img } from '../data/images.js';
import Button from './Button.astro';
import Icon from './Icon.astro';

const highlights = [
  'Vetted, directly-managed local teams',
  'Structured quality assurance & inspections',
  'Flexible after-hours & weekend scheduling',
];
---

<section id="about" class="py-20 md:py-28">
  <div class="container-x">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Images -->
      <div class="reveal relative">
        <div class="grid grid-cols-5 grid-rows-6 gap-4 h-[26rem] sm:h-[32rem]">
          <div class="col-span-3 row-span-6 rounded-2xl overflow-hidden shadow-xl shadow-forest-900/10 ring-1 ring-forest-900/5">
            <img
              src={img(images.aboutPrimary, { w: 700, h: 900 })}
              alt="Atlas field team on a client site"
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="col-span-2 row-span-3 rounded-2xl overflow-hidden shadow-xl shadow-forest-900/10 ring-1 ring-forest-900/5">
            <img
              src={img(images.aboutSecondary, { w: 500, h: 500 })}
              alt="Grounds and landscaping maintenance"
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="col-span-2 row-span-3 rounded-2xl bg-forest-600 text-white p-5 flex flex-col justify-center shadow-xl shadow-forest-900/15">
            <p class="font-display font-800 text-4xl leading-none">15<span class="text-lime-accent-400">+</span></p>
            <p class="mt-2 text-sm text-white/80 leading-snug">years of commercial cleaning experience</p>
          </div>
        </div>
      </div>

      <!-- Copy -->
      <div class="reveal" data-delay="100ms">
        <span class="eyebrow">About Atlas</span>
        <h2 class="mt-4 text-3xl sm:text-4xl font-800 text-forest-900 leading-tight">
          More than just cleaning — a partner you can rely on
        </h2>
        <p class="mt-5 text-forest-800/70 leading-relaxed">
          At Atlas, we believe great commercial cleaning is about more than emptying bins and
          vacuuming floors. It's about spaces that are consistently clean, welcoming and
          professionally maintained — and giving you confidence it's being managed properly.
        </p>
        <p class="mt-4 text-forest-800/70 leading-relaxed">
          Whether you're responsible for a small office or a multi-level building, every workplace
          operates differently. So we tailor our cleaning programs around your business, staff,
          operating hours and priorities — aiming to be a trusted long-term partner, not just
          another contractor.
        </p>

        <ul class="mt-7 space-y-3">
          {
            highlights.map((h) => (
              <li class="flex items-center gap-3 text-forest-800 font-500">
                <span class="grid place-items-center w-6 h-6 rounded-full bg-lime-accent-400 text-forest-900 shrink-0">
                  <Icon name="check" class="w-4 h-4" />
                </span>
                {h}
              </li>
            ))
          }
        </ul>

        <div class="mt-9">
          <Button href="#services" variant="primary" icon="arrow">Explore our services</Button>
        </div>
      </div>
    </div>
  </div>
</section>
