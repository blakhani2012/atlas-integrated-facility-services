---
import { services } from '../data/site.js';
import { images, img } from '../data/images.js';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { link } from '../lib/link.js';
---

<section id="services" class="py-20 md:py-28 bg-white">
  <div class="container-x">
    <div class="max-w-2xl reveal">
      <span class="eyebrow">What we do</span>
      <h2 class="mt-4 text-3xl sm:text-4xl font-800 text-forest-900 leading-tight">
        Commercial cleaning, tailored to your workplace
      </h2>
      <p class="mt-4 text-forest-800/70 leading-relaxed">
        From daily office cleaning to builders’ handovers and end-of-lease cleans, every program is
        built around your site, your hours and your priorities.
      </p>
    </div>

    <div class="mt-12 grid md:grid-cols-2 gap-6 lg:gap-7">
      {
        services.map((s, i) => (
          <a
            href={link(s.href)}
            aria-label={`${s.title} — learn more`}
            class="reveal card-lift group relative overflow-hidden rounded-2xl bg-sand-50 ring-1 ring-forest-900/5 shadow-lg shadow-forest-900/5 hover:shadow-2xl hover:ring-forest-200 flex flex-col"
            data-delay={`${(i % 2) * 90}ms`}
          >
            <div class="relative h-52 overflow-hidden">
              <img
                src={img(images.services[s.id], { w: 800, h: 520 })}
                alt={s.title}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-forest-950/55 to-transparent" />
              <span class="absolute top-4 left-4 grid place-items-center w-11 h-11 rounded-xl bg-white/90 backdrop-blur text-forest-600 shadow-md">
                <Icon name={s.icon} class="w-6 h-6" />
              </span>
              <h3 class="absolute bottom-4 left-4 right-4 font-display font-700 text-xl text-white">
                {s.title}
              </h3>
            </div>

            <div class="p-6 flex flex-col flex-1">
              <p class="text-forest-800/70 leading-relaxed">{s.summary}</p>
              <ul class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2.5">
                {s.points.map((pt) => (
                  <li class="flex items-center gap-2 text-sm text-forest-800">
                    <Icon name="check" class="w-4 h-4 text-lime-accent-600 shrink-0" />
                    {pt}
                  </li>
                ))}
              </ul>
              <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-600 text-forest-600 group-hover:text-forest-800">
                Explore this service
                <Icon name="arrow" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-12 text-center reveal">
      <Button href="#contact" variant="secondary" size="lg" icon="arrow">
        Get a free quote
      </Button>
    </div>
  </div>
</section>
