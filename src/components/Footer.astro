---
import { company, nav, services, acknowledgement } from '../data/site.js';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { link } from '../lib/link.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="bg-forest-950 text-sand-100">
  <div class="container-x py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Brand -->
      <div class="lg:col-span-4">
        <a href={link('/')} class="flex items-center gap-3">
          <Logo class="h-12 w-auto" />
          <img
            src={`${base}/images/atlas-text-white.png`}
            alt="Atlas Integrated Facility Services"
            width="3600"
            height="1128"
            class="h-8 w-auto"
          />
        </a>
        <p class="mt-5 text-sand-100/70 max-w-xs leading-relaxed">
          {company.tagline} Reliable commercial cleaning for offices, strata, end-of-lease, Airbnb, childcare and builders across Melbourne.
        </p>
        <div class="mt-6 flex gap-3">
          {
            [
              ['linkedin', company.socials.linkedin],
              ['facebook', company.socials.facebook],
              ['instagram', company.socials.instagram],
            ].map(([name, href]) => (
              <a
                href={href}
                class="w-10 h-10 rounded-full grid place-items-center bg-white/5 hover:bg-lime-accent-500 hover:text-forest-900 ring-1 ring-white/10 transition-colors"
                aria-label={name}
              >
                <span class="text-xs font-700 uppercase">{name.slice(0, 2)}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Quick links -->
      <div class="lg:col-span-2">
        <h3 class="font-display font-600 text-white text-sm uppercase tracking-wider">Company</h3>
        <ul class="mt-4 space-y-2.5">
          {
            nav.map((item) => (
              <li>
                <a href={link(item.href)} class="text-sand-100/70 hover:text-lime-accent-400 transition-colors text-sm">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Services -->
      <div class="lg:col-span-3">
        <h3 class="font-display font-600 text-white text-sm uppercase tracking-wider">Services</h3>
        <ul class="mt-4 space-y-2.5">
          {
            services.map((s) => (
              <li>
                <a href={link(s.href)} class="text-sand-100/70 hover:text-lime-accent-400 transition-colors text-sm">
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div class="lg:col-span-3">
        <h3 class="font-display font-600 text-white text-sm uppercase tracking-wider">Get in touch</h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li class="flex items-start gap-3">
            <Icon name="pin" class="w-5 h-5 text-lime-accent-400 shrink-0 mt-0.5" />
            <span class="text-sand-100/70">{company.address.locality}</span>
          </li>
          <li>
            <a href={company.phoneHref} class="flex items-center gap-3 text-sand-100/70 hover:text-lime-accent-400">
              <Icon name="phone" class="w-5 h-5 text-lime-accent-400 shrink-0" />
              {company.phone}
            </a>
          </li>
          <li>
            <a href={company.emailHref} class="flex items-center gap-3 text-sand-100/70 hover:text-lime-accent-400">
              <Icon name="mail" class="w-5 h-5 text-lime-accent-400 shrink-0" />
              {company.email}
            </a>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="clock" class="w-5 h-5 text-lime-accent-400 shrink-0 mt-0.5" />
            <span class="text-sand-100/70">{company.hours}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Acknowledgement of Country -->
    <div class="mt-12 pt-8 border-t border-white/10">
      <p class="text-xs uppercase tracking-wider text-lime-accent-400 font-600 mb-2">Acknowledgement of Country</p>
      <p class="text-sm text-sand-100/60 max-w-3xl leading-relaxed">{acknowledgement}</p>
    </div>

    <div
      class="mt-10 pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-sand-100/50"
    >
      <p>
        © {year} {company.legalName}.{company.abn ? ` ${company.abn}.` : ''} All rights reserved. ·
        <a href={link('/privacy-policy')} class="hover:text-lime-accent-400 underline underline-offset-2">Privacy Policy</a>
      </p>
      <p class="flex items-center gap-2">
        <Icon name="check" class="w-4 h-4 text-lime-accent-400" />
        Australian owned &amp; operated
      </p>
    </div>
  </div>
</footer>
